{
  "type": "object",
  "properties": {
    "roleSummary": { "type": "string" },
    "titles": { "type": "array", "items": { "type": "string" } },
    "synonyms": { "type": "array", "items": { "type": "string" } },
    "skillsWanted": { "type": "array", "items": { "type": "string" } },
    "seniority": { "type": "string", "enum": ["student", "graduate", "junior", "mid", "senior", "any"] },
    "acceptExperienceUpToYears": { "type": "integer", "minimum": 0, "maximum": 30 },
    "locations": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "name": { "type": "string" },
          "municipality": { "type": "string" },
          "radiusKm": { "type": "integer", "minimum": 0 }
        },
        "required": ["name", "municipality", "radiusKm"],
        "additionalProperties": false
      }
    },
    "remoteOk": { "type": "boolean" },
    "languages": { "type": "array", "items": { "type": "string", "enum": ["sv", "en"] } },
    "maxAgeDays": { "type": "integer", "minimum": 1, "maximum": 90 },
    "employmentTypes": { "type": "array", "items": { "type": "string", "enum": ["heltid", "deltid", "timmar"] } },
    "exclusions": { "type": "array", "items": { "type": "string" } },
    "yrkesrollForAktivitetsrapport": { "type": "string" },
    "relevantTags": { "type": "array", "items": { "type": "string" } },
    "jobtechQueries": { "type": "array", "items": { "type": "string" }, "minItems": 1 }
  },
  "required": ["roleSummary", "titles", "synonyms", "skillsWanted", "seniority", "acceptExperienceUpToYears",
               "locations", "remoteOk", "languages", "maxAgeDays", "employmentTypes", "exclusions",
               "yrkesrollForAktivitetsrapport", "relevantTags", "jobtechQueries"],
  "additionalProperties": false
}
